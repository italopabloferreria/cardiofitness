# Produção: false. Demonstração local: true, sem conexão nem dados reais.
APP_DEMO_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google: OAuth da conta dedicada da empresa, com acesso aos formulários originais.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Alternativa ao OAuth: conta de serviço com acesso explícito aos formulários.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
APP_URL=http://127.0.0.1:3000

# Ativar somente depois de configurar Google em Supabase Auth.
GOOGLE_LOGIN_ENABLED=false

# Sincronização de servidor: nunca expor estas variáveis com NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# Alternativa legada: SUPABASE_SERVICE_ROLE_KEY=
# Segredo aleatório, mínimo 32 caracteres; repetir no Supabase Vault.
CRON_SECRET=
